MORSE_HOST=0.0.0.0
MORSE_PORT=7631
MORSE_DATABASE_PATH=.local/morse.sqlite3
MORSE_DEMO_ENABLED=false
MORSE_COOKIE_SECURE=false

# ldap: directory only / local: fixed admin only / hybrid: both
MORSE_AUTH_MODE=hybrid
# Set a unique password (12-1024 characters). Empty disables the local account.
# The fixed username is admin. No default password is provided.
MORSE_ADMIN_PASSWORD=

LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=ou=People,dc=example,dc=org
LDAP_SEARCH_FILTER=uid={{username}}
LDAP_CA_CERT_PATH=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_STARTTLS=false
LDAP_LOGIN_USES_USERNAME=true
LDAP_ALLOW_PLAINTEXT=false
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_LOGIN_NOTICE_EMPHASIS_UNTIL=
LDAP_ID=uid
LDAP_USERNAME=uid
LDAP_EMAIL=
LDAP_FULL_NAME=displayName

# codex / openai / azure / bedrock / anthropic
MORSE_AI_PROVIDER=codex
# Limits for cloud providers. Codex keeps its CODEX_* limits below.
MORSE_AI_TIMEOUT_SECONDS=90
MORSE_AI_MAX_CONCURRENT=2
MORSE_AI_MAX_OUTPUT_TOKENS=2048

# OpenAI Responses API: set a model ID available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure OpenAI v1 Responses API: resource URL and deployment name.
# The endpoint may end with /openai/v1/; no api-version is required.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Anthropic Messages API: set a model ID available to your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Bedrock ConverseStream: model ID or inference profile ID/ARN.
BEDROCK_MODEL_ID=
AWS_REGION=
# Optional: use a named AWS profile, IAM role, or explicit credentials.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=90
CODEX_MAX_CONCURRENT=2
# Isolated configuration; the launcher can reuse the local Codex login.
MORSE_CODEX_HOME=.local/coach-codex
